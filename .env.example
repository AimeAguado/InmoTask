# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------- MongoDB ----

# Este proyecto usa una base propia. No reutilices la URI ni la base de otro
# proyecto: son datos que no se tocan.

# MONGODB_URI: cadena de conexión a Atlas. Se obtiene en tu cluster, en
# Atlas → Connect → Drivers. No pegues credenciales reales acá: este archivo
# está versionado. Copiá el .env.example a .env y poné tus datos ahí.
# OJO: si tu password tiene caracteres especiales (@ : / # ?) va url-encoded.
MONGODB_URI="mongodb+srv://USUARIO:PASSWORD@CLUSTER.XXXXX.mongodb.net/inmotask?retryWrites=true&w=majority"

# MONGODB_DB: nombre de la base de este proyecto. OBLIGATORIA.
# No es opcional: si faltara, el driver usaría la base del path de la URI, que
# en Atlas suele ser "test", y los datos de InmoTask caerían fuera de su base.
MONGODB_DB="inmotask"

# MONGODB_DNS_SERVERS: resolvers DNS que usa Node para el SRV de Atlas, con comas.
# Opcional. Sólo hace falta si la API no encuentra el cluster con un error
# "querySrv ECONNREFUSED" aunque nslookup resuelva bien: pasa cuando el DNS de la
# red (un router, un VPN corporativo) no contesta las consultas SRV que hace
# c-ares. En ese caso, apuntar a un resolver público lo resuelve.
# Vacía la variable para usar el DNS del sistema, que es lo habitual.
MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"

# --------------------------------------------------------------- Vercel ----

# Las mismas variables, pero en el panel de Vercel (Settings → Environment
# Variables), NO en un .env: el filesystem de una serverless function es
# efímero y no se versiona. El orden de importance:
#
#   MONGODB_URI   必需  Atlas. Es lo que hace que el login funcione desde
#                         cualquier máquina: el usuario y su passwordHash están
#                         en la base, no en el código ni en el navegador.
#   MONGODB_DB     必需  "inmotask". Ver arriba por qué no se puede omitir.
#   JWT_SECRET     必需  Clave de 64 caracteres. Sin esto NO arrancar: una clave
#                         conocida y pública permite firmar sesiones ajenas.
#   MONGODB_DNS_SERVERS  opcional, y en Vercel normalmente NO hace falta. La
#                         causa del problema era el DNS de la red local (router /
#                         VPN); en el datacenter de Vercel el resolver del
#                         sistema responde los SRV de Atlas sin problema. Si se
#                         define igual, no molesta, pero es una variable de menos.
#   PORT           no     Vercel lo inyecta solo. No hardcodear 4000.
#   CLIENT_ORIGIN  no     Sólo se usa para CORS en desarrollo; en producción el
#                         front y la API comparten origen y CORS queda apagado.
#   API_PROXY_TARGET no   Sólo lo usa el proxy de vite en dev:web.

# OJO con las fotos de perfil: se guardan en public/uploads/avatars/, que en
# Vercel es un disco efímero. Las fotos de propiedades sí sobreviven (están
# versionadas y se sirven como estáticas), pero un avatar subido por un usuario
# se pierde en el siguiente deploy. Si eso molesta, hay que mover el storage a
# S3/Vercel Blob o a Atlas GridFS.

# ------------------------------------------------------------------- API ----

# PORT: puerto del backend Express. El proxy de vite.config.ts apunta acá.
PORT=4000

# CLIENT_ORIGIN: origen permitido por CORS en desarrollo (debe coincidir con el
# puerto del script dev:web). En producción el mismo origen sirve el front, así
# que CORS queda deshabilitado.
CLIENT_ORIGIN="http://localhost:3000"

# API_PROXY_TARGET: a dónde reenvía Vite las rutas /api. Sólo si el backend
# corre en otro puerto distinto de 4000.
API_PROXY_TARGET="http://localhost:4000"

# JWT_SECRET: clave para firmar la cookie de sesión.
# En desarrollo si se omite se usa una clave fija (con warning). En producción
# es OBLIGATORIA: generá una con `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET="cambiar-esta-cadena-por-una-aleatoria-de-64-caracteres"